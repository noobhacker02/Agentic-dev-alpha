{
  "name": "agent-loop",
  "version": "0.1.0",
  "description": "Multi-agent dev-loop orchestrator: an Overseer plus five specialized worker phases (Planner, Test-Designer, Builder, Verifier, Gatekeeper) built on the Claude Agent SDK, with an indexed changelog store and a live approval UI.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agent-loop": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node --experimental-sqlite dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:plumbing": "node --experimental-sqlite test/plumbing.mjs",
    "test:server": "node --experimental-sqlite test/approval-server.mjs",
    "test:scope": "node test/tool-and-path-scope.mjs",
    "test:data-dir": "node test/data-dir.mjs",
    "test:safety": "node test/safety-net.mjs",
    "test:browser-tools": "node test/browser-tools.mjs",
    "test:ui": "node --experimental-sqlite --no-warnings test/ui-render.mjs",
    "test:terminal": "node test/terminal.mjs",
    "test:insights": "node --experimental-sqlite --no-warnings test/insights-cli.mjs",
    "test:roast": "node --experimental-sqlite --no-warnings test/roast.mjs",
    "test:doctor": "node --experimental-sqlite --no-warnings test/doctor.mjs",
    "test:stop": "node --experimental-sqlite --no-warnings --import ./test/stress/fake-sdk/register.mjs test/stop.mjs",
    "test:ui-replay": "node --experimental-sqlite --no-warnings test/ui-replay.mjs",
    "test:bus-history": "node --experimental-sqlite --no-warnings test/bus-history.mjs",
    "test": "npm run -s test:plumbing && npm run -s test:server && npm run -s test:scope && npm run -s test:data-dir && npm run -s test:safety && npm run -s test:bash && npm run -s test:rules && npm run -s test:terminal && npm run -s test:persona && npm run -s test:lineage && npm run -s test:report && npm run -s test:sprites && npm run -s test:browser-tools && npm run -s test:browser-cu && npm run -s test:ui && npm run -s test:ui-persona && npm run -s test:ui-lineage && npm run -s test:ui-mascot && npm run -s test:ui-offline && npm run -s test:ui-sound && npm run -s test:ui-plain && npm run -s test:ui-stop && npm run -s test:ui-cartoon-stress && npm run -s test:ui-desktop && npm run -s test:desktop-tools && npm run -s test:desktop-adapter && npm run -s test:desktop-cli && npm run -s test:desktop-pipeline && npm run -s test:insights && npm run -s test:roast && npm run -s test:doctor && npm run -s test:stop && npm run -s test:bus-history && npm run -s test:ui-replay",
    "test:report": "node test/report.mjs",
    "test:rules": "node test/approval-rules.mjs",
    "test:bash": "node test/bash-analysis.mjs",
    "test:browser-cu": "node test/browser-computer-use.mjs",
    "test:desktop-tools": "node test/desktop-tools.mjs",
    "test:desktop-adapter": "node test/desktop-adapter.mjs",
    "test:desktop-cli": "node test/desktop-cli.mjs",
    "test:desktop-real": "bash test/desktop-real.sh test/desktop-real.mjs test/desktop-real-adversarial.mjs test/desktop-real-cli.mjs test/desktop-real-tree.mjs && AGENT_LOOP_TEST_NO_WM=1 bash test/desktop-real.sh test/desktop-real-nowm.mjs",
    "test:desktop-pipeline": "node --experimental-sqlite --no-warnings --import ./test/stress/fake-sdk/register.mjs test/desktop-pipeline.mjs",
    "test:real-model-roast": "AGENT_LOOP_REAL_MODEL_TESTS=1 node --experimental-sqlite --no-warnings test/roast-real.mjs",
    "test:real-model-stop": "AGENT_LOOP_REAL_MODEL_TESTS=1 node --experimental-sqlite --no-warnings test/stop-real.mjs",
    "test:real-model-browser": "AGENT_LOOP_REAL_MODEL_TESTS=1 node --experimental-sqlite --no-warnings test/browser-real-sdk.mjs",
    "test:real-model-desktop": "AGENT_LOOP_REAL_MODEL_TESTS=1 bash test/desktop-real.sh test/desktop-real-sdk.mjs",
    "test:lineage": "node --experimental-sqlite --no-warnings test/lineage.mjs",
    "test:ui-lineage": "node --experimental-sqlite --no-warnings test/ui-lineage.mjs",
    "record:videos": "node --experimental-sqlite --no-warnings test/e2e/record-features.mjs all docs/media",
    "record:desktop-video": "AGENT_LOOP_VIDEO_OUT=docs/media bash test/desktop-real.sh test/e2e/record-desktop-real.mjs",
    "record:previews": "bash test/e2e/make-previews.sh",
    "test:persona": "node --experimental-sqlite --no-warnings test/persona.mjs",
    "test:ui-persona": "node --experimental-sqlite --no-warnings test/ui-persona.mjs",
    "test:ui-desktop": "node --experimental-sqlite --no-warnings test/ui-desktop.mjs",
    "test:sprites": "node --experimental-sqlite --no-warnings test/sprites.mjs",
    "test:ui-mascot": "node --experimental-sqlite --no-warnings test/ui-mascot.mjs",
    "test:ui-offline": "node --experimental-sqlite --no-warnings test/ui-offline.mjs",
    "test:ui-sound": "node --experimental-sqlite --no-warnings test/ui-sound.mjs",
    "test:ui-plain": "node --experimental-sqlite --no-warnings test/ui-plain.mjs",
    "test:ui-stop": "node --experimental-sqlite --no-warnings test/ui-stop.mjs",
    "test:ui-cartoon-stress": "node --experimental-sqlite --no-warnings test/ui-cartoon-stress.mjs",
    "check:sprites": "node scripts/check-sprites.mjs",
    "record:ui-videos": "node --experimental-sqlite --no-warnings test/e2e/record-ui-v3.mjs all docs/media",
    "shots:ui": "node --experimental-sqlite --no-warnings test/e2e/screenshots-ui-v3.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "playwright-core": "^1.63.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@trycua/cua-driver": "0.30.4"
  }
}
