{
  "name": "agent-loop",
  "version": "0.1.0",
  "description": "Multi-agent dev-loop orchestrator: an Overseer plus five specialized worker phases (Planner, Test-Designer, Builder, Verifier, Gatekeeper) built on the Claude Agent SDK, with an indexed changelog store and a live approval UI.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agent-loop": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node --experimental-sqlite dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:plumbing": "node --experimental-sqlite test/plumbing.mjs",
    "test:server": "node --experimental-sqlite test/approval-server.mjs",
    "test:scope": "node test/tool-and-path-scope.mjs",
    "test:data-dir": "node test/data-dir.mjs",
    "test:safety": "node test/safety-net.mjs",
    "test:browser-tools": "node test/browser-tools.mjs",
    "test:ui": "node --experimental-sqlite --no-warnings test/ui-render.mjs",
    "test:terminal": "node test/terminal.mjs",
    "test:insights": "node --experimental-sqlite --no-warnings test/insights-cli.mjs",
    "test:roast": "node --experimental-sqlite --no-warnings test/roast.mjs",
    "test:doctor": "node --experimental-sqlite --no-warnings test/doctor.mjs",
    "test:stop": "node --experimental-sqlite --no-warnings --import ./test/stress/fake-sdk/register.mjs test/stop.mjs",
    "test:ui-replay": "node --experimental-sqlite --no-warnings test/ui-replay.mjs",
    "test:bus-history": "node --experimental-sqlite --no-warnings test/bus-history.mjs",
    "test": "npm run -s test:plumbing && npm run -s test:server && npm run -s test:scope && npm run -s test:data-dir && npm run -s test:safety && npm run -s test:safety-rewrites && npm run -s test:bash-readonly && npm run -s test:path-text && npm run -s test:bash && npm run -s test:rules && npm run -s test:terminal && npm run -s test:persona && npm run -s test:lineage && npm run -s test:report && npm run -s test:sprites && npm run -s test:browser-tools && npm run -s test:browser-cu && npm run -s test:browser-observability && npm run -s test:browser-frames && npm run -s test:browser-popup-storm && npm run -s test:browser-hang && npm run -s test:browser-dropped-call && npm run -s test:fatal && npm run -s test:team-roster && npm run -s test:team-plan && npm run -s test:team-signals && npm run -s test:team-compose && npm run -s test:team-cli && npm run -s test:team-identity && npm run -s test:team-write-scope && npm run -s test:team-role-spec && npm run -s test:team-browser-readonly && npm run -s test:team-run-phase && npm run -s test:team-verdict && npm run -s test:team-changes && npm run -s test:net-gate && npm run -s test:browser-redirect-gate && npm run -s test:path-scope-symlink && npm run -s test:ui && npm run -s test:ui-persona && npm run -s test:ui-lineage && npm run -s test:ui-mascot && npm run -s test:ui-offline && npm run -s test:ui-sound && npm run -s test:ui-plain && npm run -s test:ui-stop && npm run -s test:stop-e2e && npm run -s test:concurrent && npm run -s test:ui-idle-cost && npm run -s test:ui-cartoon-stress && npm run -s test:ui-desktop && npm run -s test:desktop-tools && npm run -s test:desktop-adapter && npm run -s test:desktop-cli && npm run -s test:desktop-pipeline && npm run -s test:insights && npm run -s test:roast && npm run -s test:doctor && npm run -s test:stop && npm run -s test:bus-history && npm run -s test:ui-replay && npm run -s test:bench-suites && npm run -s test:bench-integrity && npm run -s test:adversary-round && npm run -s test:checkpoint && npm run -s test:bench-table && npm run -s test:improvements-log && npm run -s test:handoff",
    "test:report": "node test/report.mjs",
    "test:rules": "node test/approval-rules.mjs",
    "test:bash": "node test/bash-analysis.mjs",
    "test:browser-cu": "node test/browser-computer-use.mjs",
    "test:desktop-tools": "node test/desktop-tools.mjs",
    "test:desktop-adapter": "node test/desktop-adapter.mjs",
    "test:desktop-cli": "node test/desktop-cli.mjs",
    "test:desktop-real": "bash test/desktop-real.sh test/desktop-real.mjs test/desktop-real-adversarial.mjs test/desktop-real-cli.mjs test/desktop-real-tree.mjs && AGENT_LOOP_TEST_NO_WM=1 bash test/desktop-real.sh test/desktop-real-nowm.mjs",
    "test:desktop-pipeline": "node --experimental-sqlite --no-warnings --import ./test/stress/fake-sdk/register.mjs test/desktop-pipeline.mjs",
    "test:real-model-roast": "AGENT_LOOP_REAL_MODEL_TESTS=1 node --experimental-sqlite --no-warnings test/roast-real.mjs",
    "test:real-model-stop": "AGENT_LOOP_REAL_MODEL_TESTS=1 node --experimental-sqlite --no-warnings test/stop-real.mjs",
    "test:real-model-browser": "AGENT_LOOP_REAL_MODEL_TESTS=1 node --experimental-sqlite --no-warnings test/browser-real-sdk.mjs",
    "test:real-model-desktop": "AGENT_LOOP_REAL_MODEL_TESTS=1 bash test/desktop-real.sh test/desktop-real-sdk.mjs",
    "test:lineage": "node --experimental-sqlite --no-warnings test/lineage.mjs",
    "test:ui-lineage": "node --experimental-sqlite --no-warnings test/ui-lineage.mjs",
    "record:videos": "node --experimental-sqlite --no-warnings test/e2e/record-features.mjs all docs/media",
    "record:desktop-video": "AGENT_LOOP_VIDEO_OUT=docs/media bash test/desktop-real.sh test/e2e/record-desktop-real.mjs",
    "record:previews": "bash test/e2e/make-previews.sh",
    "record:terminal-images": "node --experimental-sqlite --no-warnings test/e2e/render-terminal.mjs docs/screenshots/terminal",
    "test:persona": "node --experimental-sqlite --no-warnings test/persona.mjs",
    "test:ui-persona": "node --experimental-sqlite --no-warnings test/ui-persona.mjs",
    "test:ui-desktop": "node --experimental-sqlite --no-warnings test/ui-desktop.mjs",
    "test:sprites": "node --experimental-sqlite --no-warnings test/sprites.mjs",
    "test:ui-mascot": "node --experimental-sqlite --no-warnings test/ui-mascot.mjs",
    "test:ui-offline": "node --experimental-sqlite --no-warnings test/ui-offline.mjs",
    "test:ui-sound": "node --experimental-sqlite --no-warnings test/ui-sound.mjs",
    "test:ui-plain": "node --experimental-sqlite --no-warnings test/ui-plain.mjs",
    "test:ui-stop": "node --experimental-sqlite --no-warnings test/ui-stop.mjs",
    "test:ui-idle-cost": "node --experimental-sqlite --no-warnings test/ui-idle-cost.mjs",
    "test:stop-e2e": "node --experimental-sqlite --no-warnings test/stop-e2e.mjs",
    "test:concurrent": "node --experimental-sqlite --no-warnings --import ./test/stress/fake-sdk/register.mjs test/concurrent-runs.mjs",
    "test:ui-cartoon-stress": "node --experimental-sqlite --no-warnings test/ui-cartoon-stress.mjs",
    "check:sprites": "node scripts/check-sprites.mjs",
    "record:ui-videos": "node --experimental-sqlite --no-warnings test/e2e/record-ui-v3.mjs all docs/media",
    "shots:ui": "node --experimental-sqlite --no-warnings test/e2e/screenshots-ui-v3.mjs",
    "bench": "node --experimental-sqlite --no-warnings bench/run.mjs",
    "test:bench-suites": "node test/bench-suites.mjs",
    "test:bench-table": "node test/bench-table.mjs",
    "test:improvements-log": "node test/improvements-log.mjs",
    "test:handoff": "node test/handoff.mjs",
    "test:browser-observability": "node --experimental-sqlite --no-warnings test/browser-observability.mjs",
    "test:browser-frames": "node --experimental-sqlite --no-warnings test/browser-frames.mjs",
    "test:team-roster": "node test/team-roster.mjs",
    "test:team-plan": "node test/team-plan.mjs",
    "test:team-signals": "node test/team-signals.mjs",
    "test:team-compose": "node test/team-compose.mjs",
    "test:team-cli": "node test/team-cli.mjs",
    "test:team-identity": "node --experimental-sqlite --no-warnings test/team-identity.mjs",
    "test:team-write-scope": "node --experimental-sqlite --no-warnings test/team-write-scope.mjs",
    "test:team-role-spec": "node --experimental-sqlite --no-warnings test/team-role-spec.mjs",
    "test:team-browser-readonly": "node --experimental-sqlite --no-warnings test/team-browser-readonly.mjs",
    "test:team-verdict": "node --experimental-sqlite --no-warnings test/team-verdict.mjs",
    "test:team-changes": "node --experimental-sqlite --no-warnings test/team-changes.mjs",
    "test:team-run-phase": "node --experimental-sqlite --no-warnings --import ./test/stress/fake-sdk/register.mjs test/team-run-phase.mjs",
    "test:bash-readonly": "node test/bash-readonly.mjs",
    "test:path-text": "node test/path-text.mjs",
    "test:fatal": "node --experimental-sqlite --no-warnings test/fatal.mjs",
    "test:browser-hang": "node --experimental-sqlite --no-warnings test/browser-hang.mjs",
    "test:browser-dropped-call": "node --experimental-sqlite --no-warnings test/browser-dropped-call.mjs",
    "test:browser-popup-storm": "node --experimental-sqlite --no-warnings test/browser-popup-storm.mjs",
    "test:safety-rewrites": "node test/safety-rewrites.mjs",
    "test:net-gate": "node --experimental-sqlite --no-warnings test/net-gate.mjs",
    "test:browser-redirect-gate": "node --experimental-sqlite --no-warnings test/browser-redirect-gate.mjs",
    "test:path-scope-symlink": "node test/path-scope-symlink.mjs",
    "test:bench-integrity": "node test/bench-integrity.mjs",
    "test:adversary-round": "node test/adversary-round.mjs",
    "checkpoint": "node scripts/checkpoint.mjs",
    "test:checkpoint": "node test/checkpoint.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "playwright-core": "^1.63.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@trycua/cua-driver": "0.30.4"
  }
}
