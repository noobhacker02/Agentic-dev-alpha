#!/usr/bin/env bash
# Installed by install-hooks.sh — do not run this file directly from outside .githooks/.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${PYTHON:-python3}"

if ! command -v "$PY" >/dev/null 2>&1; then
  echo "[dev-workflow] python3 not found — cannot run the pre-commit safety checks." >&2
  echo "[dev-workflow] Install python3, or set PYTHON=/path/to/python3, then retry." >&2
  exit 1
fi

exec "$PY" "$HOOK_DIR/check_staged.py" --mode=commit
