#!/usr/bin/env bash
# Installed by install-hooks.sh — do not run this file directly from outside .githooks/.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# `python3` is the command name on Linux/macOS; many Windows installs (the standard python.org
# installer, in particular) only put `python` on PATH, not `python3`. Try both, actually checking
# each is really Python 3 (not a stray Python 2) before trusting it -- a confusing SyntaxError from
# running this under Python 2 would be worse than a clear "not found" message.
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)' 2>/dev/null; then
      PY="$candidate"
      break
    fi
  done
fi

if [ -z "$PY" ] || ! command -v "$PY" >/dev/null 2>&1; then
  echo "[dev-workflow] no Python 3 interpreter found (tried python3, python) — cannot run the" >&2
  echo "[dev-workflow] pre-commit safety checks. Install Python 3, or set PYTHON=/path/to/python3." >&2
  exit 1
fi

exec "$PY" "$HOOK_DIR/check_staged.py" --mode=commit
